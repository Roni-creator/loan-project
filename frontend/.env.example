# Frontend dev-server configuration. Copy to .env to override the defaults.
# Loaded by vite.config.js (see VITE_API_TARGET) for `npm run dev`.
#
# Where the Vite dev server forwards /api requests. Only needed when Flask is
# not on the default host/port (python webapp.py listens on 127.0.0.1:8000).
VITE_API_TARGET=http://127.0.0.1:8000
