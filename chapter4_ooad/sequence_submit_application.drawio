        <mxCell id="m22_l" value="&lt;span style='color:#8A94A6;display:inline-block;width:14px;text-align:right;'&gt;22&lt;/span&gt; 201 Created" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#5A6272;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="m22">
          <mxGeometry x="0" relative="1" as="geometry">
