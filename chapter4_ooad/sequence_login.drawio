        <mxCell id="m11" style="html=1;endArrow=open;endFill=0;endSize=7;strokeColor=#5A6272;strokeWidth=1.15;dashed=1;exitX=0.0000;exitY=0.9896;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.9037;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar_api_2" target="bar_webapp_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11_l" value="&lt;span style='color:#8A94A6;display:inline-block;width:14px;text-align:right;'&gt;11&lt;/span&gt; user · csrf · Set-Cookie" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#5A6272;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="m11">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" style="html=1;endArrow=open;endFill=0;endSize=7;strokeColor=#5A6272;strokeWidth=1.15;dashed=1;exitX=0.0000;exitY=0.9934;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.8889;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar_webapp_0" target="life_visitor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12_l" value="&lt;span style='color:#8A94A6;display:inline-block;width:14px;text-align:right;'&gt;12&lt;/span&gt; 200 + HttpOnly cookie" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#5A6272;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="m12">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note1" value="&lt;div style='font-size:9.6px;font-weight:bold;color:#8A5A2B;margin-bottom:2px;'&gt;Password check&lt;/div&gt;&lt;div style='font-size:8.9px;line-height:12.2px;color:#333333;'&gt;verify_user normalises the email, loads the account and checks the werkzeug hash. Legacy bcrypt hashes are upgraded on success; unknown email and wrong password share one 401.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=11;fillColor=#FFF8E1;strokeColor=#B7791F;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="862.0" width="508.7" height="84.0" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;div style='font-size:9.6px;font-weight:bold;color:#8A5A2B;margin-bottom:2px;'&gt;Session&lt;/div&gt;&lt;div style='font-size:8.9px;line-height:12.2px;color:#333333;'&gt;A random token is stored only as a SHA-256 hash in auth_sessions and returned in an HttpOnly, SameSite=Lax cookie (12 h TTL). The CSRF token travels in the JSON body.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=11;fillColor=#FFF8E1;strokeColor=#B7791F;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="572.7" y="862.0" width="508.7" height="84.0" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;div style='font-size:9.6px;font-weight:bold;color:#8A5A2B;margin-bottom:2px;'&gt;Audit&lt;/div&gt;&lt;div style='font-size:8.9px;line-height:12.2px;color:#333333;'&gt;log_audit records login or login_failed with actor and IP. Passwords and tokens are never logged, and a failed login creates no session row.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=11;fillColor=#FFF8E1;strokeColor=#B7791F;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1105.3" y="862.0" width="508.7" height="84.0" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;div style='font-size:12px;font-weight:bold;color:#1F3864;border-bottom:1px solid #C9D2E0;padding-bottom:3px;margin-bottom:5px;'&gt;Notation&lt;/div&gt;&lt;div style='font-size:9.3px;line-height:14px;color:#333333;'&gt;&lt;b&gt;Solid arrow, filled head&lt;/b&gt; — synchronous call, numbered in execution order&lt;br&gt;&lt;b&gt;Dashed arrow, open head&lt;/b&gt; — return value or response (not a new request)&lt;br&gt;&lt;b&gt;Narrow bar&lt;/b&gt; — activation: the participant is executing that call&lt;br&gt;&lt;b&gt;Participant box&lt;/b&gt; — class or module taking part; the dashed line is its lifeline&lt;br&gt;&lt;b&gt;Numbered label&lt;/b&gt; — the position of the message in the overall sequence&lt;br&gt;&lt;b&gt;Note&lt;/b&gt; — constraint, guard or failure path&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#8A94A6;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="970.0" width="700.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;div style='font-size:9.6px;font-weight:bold;color:#8A5A2B;margin-bottom:2px;'&gt;Scope &amp;amp; conventions&lt;/div&gt;&lt;div style='font-size:8.9px;line-height:12.2px;color:#333333;'&gt;POST /api/auth/login is CSRF-exempt because no session exists yet. Registration also creates a session but is a separate use case; staff accounts are provisioned by an administrator, not self-registered. Logout deletes the session row, which kills the cookie immediately.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=11;fillColor=#FFF8E1;strokeColor=#B7791F;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="970.0" width="854.0" height="150.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
