          <mxGeometry x="-0.9" relative="1" as="geometry"><mxPoint x="14" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="r9_c2" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#C55A11;" vertex="1" connectable="0" parent="r9">
          <mxGeometry x="0.98" relative="1" as="geometry"><mxPoint x="20" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="legend" value="&lt;div style='background:#1F3864;color:#FFFFFF;font-size:13px;font-weight:bold;height:28px;line-height:28px;padding:0 8px;'&gt;Legend &#8212; crow&#8217;s foot notation&lt;/div&gt;&lt;div style='padding:5px 8px;font-size:11px;line-height:17px;color:#111111;'&gt;&lt;div&gt;&lt;span style='display:inline-block;width:30px;height:14px;line-height:14px;font-size:9px;font-weight:bold;color:#FFFFFF;background:#B7791F;text-align:center;border-radius:3px;vertical-align:middle;margin-right:6px;'&gt;PK&lt;/span&gt;Primary key&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:30px;height:14px;line-height:14px;font-size:9px;font-weight:bold;color:#FFFFFF;background:#2E75B6;text-align:center;border-radius:3px;vertical-align:middle;margin-right:6px;'&gt;FK&lt;/span&gt;Foreign key&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:30px;height:14px;line-height:14px;font-size:9px;font-weight:bold;color:#FFFFFF;background:#6B46C1;text-align:center;border-radius:3px;vertical-align:middle;margin-right:6px;'&gt;U&lt;/span&gt;Unique constraint or index&lt;/div&gt;&lt;div&gt;Fork = many &#183; bar = exactly one &#183; circle = zero (optional)&lt;/div&gt;&lt;div&gt;Parent end always 1 &#183; child end 0..* or 0..1&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:22px;height:0;border-top:2px solid #C55A11;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Orange: officer-facing keys&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:22px;height:0;border-top:2px dashed #6B46C1;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Dashed: logical, not DB-enforced&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:13px;height:12px;background:#1F3864;border-radius:2px;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Accounts and audit&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:13px;height:12px;background:#155E56;border-radius:2px;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Scoring and model metadata&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:13px;height:12px;background:#5B3E96;border-radius:2px;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Loan workflow&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="460" height="204" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;div style='background:#3A4A5A;color:#FFFFFF;font-size:13px;font-weight:bold;height:28px;line-height:28px;padding:0 8px;'&gt;Scope note &#8212; this diagram models the implemented SQLite database&lt;/div&gt;&lt;div style='padding:6px 8px;font-size:11px;line-height:17px;color:#111111;'&gt;&lt;div&gt;&#8226; &#160;The 8 entities below are the tables of &lt;b&gt;creditscore.db&lt;/b&gt;. CSV exports and Power BI query outputs are not database entities and are excluded.&lt;/div&gt;&lt;div&gt;&#8226; &#160;&lt;b&gt;applicants&lt;/b&gt; holds scoring records, including bulk-scored rows (2,012 rows). &lt;b&gt;loan_applications&lt;/b&gt; holds applications submitted through the authenticated workflow (11 rows). They are separate entities, linked only by &lt;b&gt;loan_applications.applicant_id&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&#8226; &#160;&lt;b&gt;applicants &#8594; loan_applications is 0..1 by application logic only&lt;/b&gt;: there is no UNIQUE constraint on applicant_id, so the database does not enforce it (dashed edge).&lt;/div&gt;&lt;div&gt;&#8226; &#160;Assignment is not a separate entity: the current officer is stored in &lt;b&gt;loan_applications.assigned_officer_id&lt;/b&gt;, and assignment events are written to &lt;b&gt;audit_log&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&#8226; &#160;&lt;b&gt;application_decisions&lt;/b&gt; stores the officer&#8217;s credit decision (approved, declined, more_info) &#8212; these are not repayment outcomes.&lt;/div&gt;&lt;div&gt;&#8226; &#160;&lt;b&gt;model_runs&lt;/b&gt; is isolated model evaluation / run metadata and has no foreign keys.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#3A4A5A;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="880" width="900" height="204" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
