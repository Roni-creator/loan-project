        <mxCell id="legend" value="&lt;div style='background:#1F3864;color:#FFFFFF;font-size:13px;font-weight:bold;height:28px;line-height:28px;padding:0 8px;'&gt;Legend&lt;/div&gt;&lt;div style='padding:5px 8px;font-size:11px;line-height:17px;color:#111111;'&gt;&lt;div&gt;&lt;span style='display:inline-block;width:30px;height:14px;line-height:14px;font-size:9px;font-weight:bold;color:#FFFFFF;background:#B7791F;text-align:center;border-radius:3px;vertical-align:middle;margin-right:6px;'&gt;PK&lt;/span&gt;Primary key (INTEGER PRIMARY KEY AUTOINCREMENT)&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:30px;height:14px;line-height:14px;font-size:9px;font-weight:bold;color:#FFFFFF;background:#2E75B6;text-align:center;border-radius:3px;vertical-align:middle;margin-right:6px;'&gt;FK&lt;/span&gt;Foreign key &#8594; parent table primary key&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:30px;height:14px;line-height:14px;font-size:9px;font-weight:bold;color:#FFFFFF;background:#6B46C1;text-align:center;border-radius:3px;vertical-align:middle;margin-right:6px;'&gt;U&lt;/span&gt;Unique constraint or unique index&lt;/div&gt;&lt;div&gt;NN = NOT NULL &#183; AI = AUTOINCREMENT &#183; DEF = DEFAULT value&lt;/div&gt;&lt;div&gt;Crow&#8217;s foot: bar = one &#183; circle = zero &#183; fork = many&lt;/div&gt;&lt;div&gt;Edge labels read parent (1) &#8594; child (0..*)&#59; the FK sits on the child&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:13px;height:12px;background:#1F3864;border-radius:2px;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Accounts and access&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:13px;height:12px;background:#155E56;border-radius:2px;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Scoring and model audit&lt;/div&gt;&lt;div&gt;&lt;span style='display:inline-block;width:13px;height:12px;background:#5B3E96;border-radius:2px;vertical-align:middle;margin-right:6px;'&gt;&#160;&lt;/span&gt;Loan workflow&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="440" height="214" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;div style='background:#3A4A5A;color:#FFFFFF;font-size:13px;font-weight:bold;height:28px;line-height:28px;padding:0 8px;'&gt;Constraint reference &#8212; CHECK constraints and unique indexes&lt;/div&gt;&lt;div style='padding:6px 8px;font-size:11px;line-height:18px;color:#111111;'&gt;&lt;div&gt;&lt;b&gt;users.role&lt;/b&gt; CHECK (business_manager, credit_analyst, loan_officer, applicant)&lt;/div&gt;&lt;div&gt;&lt;b&gt;predictions.decision&lt;/b&gt; CHECK (Good, Bad)&lt;/div&gt;&lt;div&gt;&lt;b&gt;loan_applications.status&lt;/b&gt; CHECK (submitted, assigned, approved, declined, more_info) &#183; DEFAULT &#8216;submitted&#8217;&lt;/div&gt;&lt;div&gt;&lt;b&gt;application_decisions.decision&lt;/b&gt; CHECK (approved, declined, more_info, assigned)&lt;/div&gt;&lt;div&gt;&lt;b&gt;users.email&lt;/b&gt; partial unique index &lt;b&gt;idx_users_email_unique&lt;/b&gt; on lower(email) WHERE email IS NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;model_runs&lt;/b&gt; unique index &lt;b&gt;ux_model_runs&lt;/b&gt; on (model_name, setting, threshold, accuracy, precision_bad, recall_bad, f1_bad, roc_auc, pr_auc_bad)&lt;/div&gt;&lt;div&gt;&lt;b&gt;predictions&lt;/b&gt; has no unique constraint on (applicant_id, model_name) &#8212; duplicate rows are possible&lt;/div&gt;&lt;div&gt;Non-unique indexes: idx_pred_applicant, idx_sessions_user, idx_app_user, idx_app_status, idx_decisions_app, idx_audit_created&#59; foreign keys are enabled per connection (PRAGMA foreign_keys = ON)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#3A4A5A;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="880" width="1020" height="214" as="geometry" />
        </mxCell>
