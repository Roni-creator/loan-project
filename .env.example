# Copy to .env and adjust. Never commit the real .env (it is git-ignored).
# These are read by webapp.py / auth.py / db.py with sensible defaults, so the
# app still runs with nothing set. Set them before deploying anywhere shared.

# Flask secret key. Change this to a long random string in any non-dev setup.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Name of the session cookie and how long a login lasts.
SESSION_COOKIE_NAME=loan_session
SESSION_LIFETIME_HOURS=12

# Set to 1/true when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=0

# Path to the SQLite database. Defaults to creditscore.db next to the code.
# CREDITSCORE_DB=C:\path\to\creditscore.db
